meta {
  name: escalasMinisterioRevisarRandomizacao
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/api/v1/escalas-ministerio/lider-ministerio/{{escalaEventoId}}/revisar-randomizacao/{{membroMinisterioId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body:json {
  [
    {
      "idExternoMembroMinisterio": "{{membroMinisterioId}}",
      "nome": "Membro Teste",
      "status": "NAO_CONFIRMADO"
    }
  ]
}

settings {
  encodeUrl: true
  timeout: 0
}
