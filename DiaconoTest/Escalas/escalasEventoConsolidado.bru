meta {
  name: escalasEventoConsolidado
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/api/v1/escalas-evento/governo?mes={{mesEvento}}&ano={{anoEvento}}&status={{statusEvento}}&ministerioId={{ministerioId}}&nomeEvento={{nomeEvento}}
  body: none
  auth: bearer
}

params:query {
  mes: {{mesEvento}}
  ano: {{anoEvento}}
  status: {{statusEvento}}
  ministerioId: {{ministerioId}}
  nomeEvento: {{nomeEvento}}
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
