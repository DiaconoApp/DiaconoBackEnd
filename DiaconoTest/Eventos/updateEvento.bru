meta {
  name: updateEvento
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/api/v1/eventos/{{eventoId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "fkMinisterios": [
      "{{ministerioId1}}",
      "{{ministerioId2}}"
    ],
    "nome": "{{nomeEvento}}",
    "descricao": "EVENTO ATUALIZADO",
    "publicoAlvo": "MEMBROS",
    "dataHoraInicio": "{{dataHoraInicio}}",
    "dataHoraFim": "{{dataHoraFim}}",
    "custo": 0,
    "endereco": {
      "idExterno": null,
      "cep": "04094000",
      "rua": "PARQUE IBIRAPUERA",
      "cidade": "SAO PAULO",
      "estado": "SP",
      "bairro": "VILA MARIANA",
      "complemento": "PORTAO PRINCIPAL",
      "numero": "S N",
      "apelido": "LOCAL EVENTO"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
