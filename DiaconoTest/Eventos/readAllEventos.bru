meta {
  name: readAllEventos
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/eventos?mes={{mesEvento}}&ano={{anoEvento}}
  body: none
  auth: bearer
}

params:query {
  mes: {{mesEvento}}
  ano: {{anoEvento}}
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
