meta {
  name: 03 Capturar EventoId
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/eventos?mes={{mesEvento}}&ano={{anoEvento}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

script:post-response {
  const body = res.getBody();
  const eventos = body.eventosMes || [];
  const alvo = eventos.find((e) => e.nome === bru.getVar("nomeEvento"));

  if (!alvo) {
    const nomes = eventos.map((e) => e.nome).join(", ");
    throw new Error(
      `Evento criado nao encontrado na listagem do mes/ano. nomeEvento=${bru.getVar("nomeEvento")} mes=${bru.getVar("mesEvento")} ano=${bru.getVar("anoEvento")} retornados=[${nomes}]`
    );
  }

  bru.setVar("eventoId", alvo.idExterno);
}

tests {
  test("deve obter eventoId do evento criado", function () {
    expect(res.getStatus()).to.equal(200);
    expect(bru.getVar("eventoId")).to.be.a("string");
  });
}
