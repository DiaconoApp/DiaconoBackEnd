meta {
  name: 09 Alimentar Primeira Escala
  type: http
  seq: 9
}

patch {
  url: {{baseUrl}}/api/v1/escalas-ministerio/lider-ministerio/{{escalaEventoId1}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body:json {
  [
    {
      "idExternoMembroMinisterio": "{{membroMinisterioId1}}",
      "status": "CONFIRMADO"
    }
  ]
}

tests {
  test("deve salvar primeira escala", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.message).to.contain("Escala de membros do ministério atualizada com sucesso");
  });
}

