meta {
  name: 15 Validacao Final Evento Confirmado
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/api/v1/escalas-evento/governo?mes={{mesEvento}}&ano={{anoEvento}}&nomeEvento={{nomeEvento}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("evento deve ficar confirmado apos alimentar as duas escalas", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(Array.isArray(body)).to.equal(true);
    expect(body.length).to.equal(1);
    expect(body[0].idExternoEvento).to.equal(bru.getVar("eventoId"));
    expect(body[0].status).to.equal("CONFIRMADO");
  });
}

