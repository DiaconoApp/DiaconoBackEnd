meta {
  name: 11 Validacao Intermediaria Escala2 Nao Confirmada
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/escalas-ministerio/lider-ministerio/{{escalaEventoId2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

tests {
  test("escala 2 ainda nao confirmada", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(Array.isArray(body)).to.equal(true);
    expect(body.length).to.be.greaterThan(0);

    const existeNaoConfirmado = body.some((m) => m.status !== "CONFIRMADO");
    expect(existeNaoConfirmado).to.equal(true);
  });
}

