meta {
  name: 07 Validacao Inicial Escala2 Nao Confirmada
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/api/v1/escalas-ministerio/lider-ministerio/{{escalaEventoId2}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenLiderMinisterio}}
}

script:post-response {
  const body = res.getBody();

  if (!Array.isArray(body)) {
    throw new Error(`Resposta invalida ao consultar membros da escala 2. body=${JSON.stringify(body)}`);
  }

  const membroDisponivel = body.find((membro) => membro && membro.isMembroOcupado === false);

  if (!membroDisponivel || !membroDisponivel.membroMinisterioId) {
    throw new Error("Nao foi encontrado membro disponivel para a segunda escala do fluxo de confirmacao");
  }

  bru.setVar("membroMinisterioEscala2DisponivelId", membroDisponivel.membroMinisterioId);
}

tests {
  test("escala 2 inicia sem confirmacao", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(Array.isArray(body)).to.equal(true);
    expect(body.length).to.be.greaterThan(0);

    const possuiConfirmado = body.some((m) => m.status === "CONFIRMADO");
    expect(possuiConfirmado).to.equal(false);
    expect(bru.getVar("membroMinisterioEscala2DisponivelId")).to.be.a("string");
  });
}
