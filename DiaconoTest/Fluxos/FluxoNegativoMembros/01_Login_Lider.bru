meta {
  name: 01 Login Lider
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{emailLiderMinisterio}}",
    "senha": "{{senhaLiderMinisterio}}"
  }
}

script:post-response {
  const body = res.getBody();
  const token = body.acessToken || body.accessToken || "";
  bru.setVar("tokenLiderMinisterio", token);
}

tests {
  test("deve autenticar lider", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(Boolean(body.acessToken || body.accessToken)).to.equal(true);
  });
}
