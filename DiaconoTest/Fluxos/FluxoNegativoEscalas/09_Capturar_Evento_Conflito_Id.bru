meta {
  name: 09 Capturar Evento Conflito Id
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/api/v1/eventos?mes={{mesEventoNegEscala}}&ano={{anoEventoNegEscala}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenGoverno}}
}

script:post-response {
  const body = res.getBody();
  const eventos = body.eventosMes || [];
  const alvo = eventos.find((e) => e.nome === bru.getVar("nomeEventoNegEscalaB"));

  if (!alvo) {
    throw new Error("Evento de conflito nao encontrado na listagem");
  }

  bru.setVar("eventoNegEscalaBId", alvo.idExterno);
}

tests {
  test("deve obter id do evento de conflito", function () {
    expect(res.getStatus()).to.equal(200);
    expect(bru.getVar("eventoNegEscalaBId")).to.be.a("string");
  });
}
