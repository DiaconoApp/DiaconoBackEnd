meta {
  name: 08 Criar Evento Conflito
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/eventos
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenGoverno}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "fkMinisterios": [
      "{{ministerioId1}}"
    ],
    "endereco": {
      "idExterno": null,
      "cep": "04094000",
      "estado": "SP",
      "cidade": "SAO PAULO",
      "bairro": "VILA MARIANA",
      "rua": "PARQUE IBIRAPUERA",
      "complemento": "PORTAO PRINCIPAL",
      "numero": "S N",
      "apelido": "LOCAL EVENTO CONFLITO"
    },
    "recorrencia": {
      "tipoRecorrencia": "NAO_REPETE",
      "dataInicioRecorrencia": null,
      "dataTerminoRecorrencia": null
    },
    "nome": "{{nomeEventoNegEscalaB}}",
    "descricao": "Culto negativo conflito",
    "publicoAlvo": "MEMBROS",
    "dataHoraInicio": "{{dataHoraInicioNegEscala}}",
    "dataHoraFim": "{{dataHoraFimNegEscala}}",
    "custo": 0
  }
}

tests {
  test("deve criar evento de conflito", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
