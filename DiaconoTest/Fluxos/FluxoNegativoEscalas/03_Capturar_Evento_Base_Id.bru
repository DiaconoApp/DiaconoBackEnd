meta {
  name: 03 Capturar Evento Base Id
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/eventos?mes={{mesEventoNegEscala}}&ano={{anoEventoNegEscala}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenGoverno}}
}

script:post-response {
  const body = res.getBody();
  const eventos = body.eventosMes || [];
  const alvo = eventos.find((e) => e.nome === bru.getVar("nomeEventoNegEscalaA"));

  if (!alvo) {
    throw new Error("Evento base negativo nao encontrado na listagem");
  }

  bru.setVar("eventoNegEscalaAId", alvo.idExterno);
}

tests {
  test("deve obter id do evento base", function () {
    expect(res.getStatus()).to.equal(200);
    expect(bru.getVar("eventoNegEscalaAId")).to.be.a("string");
  });
}
