meta {
  name: editarMinisterioGoverno
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/api/v1/ministerios/governo/{{ministerioId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "nome": "MINISTERIO TESTE EDITADO",
    "status": "ATIVO",
    "idLider": "{{membroId}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
