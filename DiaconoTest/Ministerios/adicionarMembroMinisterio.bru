meta {
  name: adicionarMembroMinisterio
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/api/v1/ministerios/lider-ministerio/{{ministerioId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "idExterno": "{{membroId}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
