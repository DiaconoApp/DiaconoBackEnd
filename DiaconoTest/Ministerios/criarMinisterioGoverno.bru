meta {
  name: criarMinisterioGoverno
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/ministerios/governo
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "idLider": "{{membroId}}",
    "nome": "MINISTERIO TESTE"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
