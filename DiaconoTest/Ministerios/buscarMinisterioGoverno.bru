meta {
  name: buscarMinisterioGoverno
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/ministerios/governo?page={{page}}&size={{size}}&buscaGeral={{buscaGeral}}&status={{statusMinisterio}}
  body: none
  auth: bearer
}

params:query {
  page: {{page}}
  size: {{size}}
  buscaGeral: {{buscaGeral}}
  status: {{statusMinisterio}}
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
