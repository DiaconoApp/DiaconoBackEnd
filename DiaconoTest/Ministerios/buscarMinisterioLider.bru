meta {
  name: buscarMinisterioLider
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/v1/ministerios/lider-ministerio/{{ministerioId}}?page={{page}}&size={{size}}&buscaGeral={{buscaGeral}}&status={{statusMembro}}
  body: none
  auth: bearer
}

params:query {
  page: {{page}}
  size: {{size}}
  buscaGeral: {{buscaGeral}}
  status: {{statusMembro}}
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
