meta {
  name: Cadastro Externo
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/register
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "fkIgreja": "{{igrejaId}}",
    "nome": "Novo Membro",
    "cpf": "99209712005",
    "dataNascimento": "2000-10-20",
    "email": "novo.membro@email.com",
    "celular": "11999999999",
    "senha": "Senha@123",
    "generoMembro": "MASCULINO",
    "membroEnderecoDTO": {
      "cep": "01009459",
      "estado": "SP",
      "cidade": "SAO PAULO",
      "bairro": "CENTRO",
      "rua": "RUA TESTE",
      "complemento": "APTO 10",
      "numero": "100"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
