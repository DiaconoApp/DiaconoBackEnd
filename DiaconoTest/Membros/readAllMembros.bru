meta {
  name: readAllMembros
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/membros?page={{page}}&size={{size}}&sort=nome,asc
  body: none
  auth: bearer
}

params:query {
  page: {{page}}
  size: {{size}}
  sort: nome,asc
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
