meta {
  name: readAllWithFilter
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/membros?page={{page}}&size={{size}}&sort=nome,desc&buscaGeral={{buscaGeral}}&status={{statusMembro}}&fkMinisterio={{ministerioId}}
  body: none
  auth: bearer
}

params:query {
  page: {{page}}
  size: {{size}}
  sort: nome,desc
  buscaGeral: {{buscaGeral}}
  status: {{statusMembro}}
  fkMinisterio: {{ministerioId}}
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
