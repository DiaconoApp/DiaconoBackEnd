meta {
  name: Create Membro
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/membros
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

headers {
  content-type: application/json
}

body:json {
  {
    "fkIgreja": "{{igrejaId}}",
    "nome": "Lucas Oliveira",
    "cpf": "52998224725",
    "dataNascimento": "1992-03-15",
    "email": "lucas.oliveira@email.com",
    "celular": "11912345678",
    "senha": "Senha@123",
    "idExternoMinisterios": [
      "{{ministerioId}}"
    ],
    "cargo": "MEMBRO",
    "generoMembro": "MASCULINO",
    "membroEnderecoDTO": {
      "cep": "01310100",
      "estado": "SP",
      "cidade": "SAO PAULO",
      "bairro": "BELA VISTA",
      "rua": "RUA ILHA DOS RATONES",
      "numero": "1500",
      "complemento": "APTO 304"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
