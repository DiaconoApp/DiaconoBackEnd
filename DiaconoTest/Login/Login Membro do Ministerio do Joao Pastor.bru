meta {
  name: Login Membro Ministerio do Joao Pastor
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/v1/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "{{emailMembroMinisterio}}",
    "senha": "{{senhaMembroMinisterio}}"
  }
}

script:post-response {
  const body = res.getBody();
  const token = body.acessToken || body.accessToken || "";
  bru.setVar("tokenMembroMinisterio", token);
  bru.setVar("token", token);
}

tests {
  test("deve autenticar membro relacionado ao ministerio do joao pastor", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(Boolean(body.acessToken || body.accessToken)).to.equal(true);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
