meta {
  name: Google Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/auth/google
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "token": "{{googleToken}}"
  }
}

script:post-response {
  const body = res.getBody();
  bru.setVar("token", body.acessToken || body.accessToken || "");
}

settings {
  encodeUrl: true
  timeout: 0
}
