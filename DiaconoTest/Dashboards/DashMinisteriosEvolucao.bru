meta {
  name: DashMinisteriosEvolucao
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/v1/dashboards/ministerios/evolucao/{{ministerioId}}?anoInicio={{anoInicio}}&anoFim={{anoFim}}
  body: none
  auth: bearer
}

params:query {
  anoInicio: {{anoInicio}}
  anoFim: {{anoFim}}
}

auth:bearer {
  token: {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
