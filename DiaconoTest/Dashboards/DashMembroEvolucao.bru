meta {
  name: DashMembroEvolucao
  type: http
  seq: 2
}

get {
  url: http://localhost:8080/membros/evolucao?anoInicio=2024&anoFim=2025
  body: none
  auth: bearer
}

params:query {
  anoInicio: 2024
  anoFim: 2025
}

auth:bearer {
  token: {{acessToken}}
}

settings {
  encodeUrl: true
  timeout: 0
}
